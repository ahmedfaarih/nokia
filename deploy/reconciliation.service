[Unit]
Description=Nokia Reconciliation Assistant (ReconRadar / v2, Streamlit)
After=network.target

[Service]
# Edit these two paths/user for your server, then:
#   sudo cp deploy/reconciliation.service /etc/systemd/system/reconciliation.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now reconciliation
User=deploy
WorkingDirectory=/opt/recon_tool/v2
ExecStart=/opt/recon_tool/v2/venv/bin/streamlit run app.py --server.port=8501 --server.address=127.0.0.1 --server.headless=true --browser.gatherUsageStats=false
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
