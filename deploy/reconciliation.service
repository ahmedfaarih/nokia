[Unit]
Description=Nokia Intercompany Reconciliation Assistant
After=network.target

[Service]
# Edit these two paths/user for your server, then:
#   sudo cp deploy/reconciliation.service /etc/systemd/system/reconciliation.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now reconciliation
User=deploy
WorkingDirectory=/opt/recon_tool/recon_tool/backend
ExecStart=/opt/recon_tool/recon_tool/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
